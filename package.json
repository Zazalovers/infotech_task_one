{
  "name": "mail-queue-service",
  "version": "1.0.0",
  "private": true,
  "description": "Monolithic backend that queues emails in PostgreSQL and delivers them via Resend from a background worker.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker-main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run migrate:prod && node dist/src/server.js",
    "start:worker": "node dist/src/worker-main.js",
    "migrate:up": "tsx scripts/migrate.ts up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:arch": "depcruise src scripts --config .dependency-cruiser.cjs && node scripts/check-no-sql.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/api",
    "test:integration": "vitest run tests/integration",
    "migrate:prod": "node dist/scripts/migrate.js up"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "resend": "^6.37.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
