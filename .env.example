# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database: either DATABASE_URL, or the PG* variables below ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mailqueue
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=mailqueue
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# --- API auth for /emails endpoints (send as x-api-key header) ---
API_KEY=change-me-to-a-long-random-string

# --- Worker ---
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=10
WORKER_LOCK_SECONDS=60
EMAIL_MAX_ATTEMPTS=4
EMAIL_RETRY_BASE_MS=10000

# --- Monitoring (optional) ---
ASNIHER_HEARTBEAT_URL=
HEARTBEAT_INTERVAL_MS=60000
